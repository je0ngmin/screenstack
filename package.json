{
  "name": "screenstack",
  "version": "1.0.4",
  "description": "App-style screen navigation for the web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/je0ngmin/screenstack.git"
  },
  "homepage": "https://je0ngmin.github.io/screenstack/",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "pnpm build && pnpm --dir examples/basic dev",
    "build": "tsdown",
    "example:build": "pnpm --dir examples/basic build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm example:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsdown": "^0.22.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@10.29.3"
}
